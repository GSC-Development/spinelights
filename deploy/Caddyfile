# Drop in /etc/caddy/Caddyfile (or use sites-enabled if you've split it).
#
# This config:
#   * Serves the app at spine.gsc.org.uk on the venue LAN. The hostname
#     resolves only on internal DNS (split-horizon) — Caddy issues a cert
#     from its own internal CA via `tls internal`.
#   * Proxies to the local uvicorn on 127.0.0.1:8000.
#   * Blocks requests not originating from the venue LAN (defence in depth).
#
# First-time setup: devices will see a cert warning until they trust
# Caddy's root CA. Find it at
#   /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt
# and distribute via MDM, or have users add the exception manually.
#
# To switch to a real Let's Encrypt cert (requires DNS access to gsc.org.uk):
# replace `tls internal` with `tls { dns <provider> <api_token_env> }`
# using the appropriate Caddy DNS plugin.

spine.gsc.org.uk {
    encode zstd gzip
    tls internal

    # Block requests that aren't from the venue LAN. Adjust subnet to suit.
    @not_lan {
        not remote_ip 192.168.0.0/16 10.0.0.0/8 127.0.0.1/32
    }
    respond @not_lan "Not from this network" 403

    reverse_proxy 127.0.0.1:8000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }

    log {
        output stdout
        format console
    }
}
